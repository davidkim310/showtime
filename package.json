{
  "name": "showtime",
  "version": "0.1.0",
  "private": true,
  "description": "Showtime — a full ticketing service application (work in progress)",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:client": "esbuild src/client/checkout.tsx --bundle --minify --define:process.env.NODE_ENV='\"production\"' --outfile=public/checkout.js",
    "dev:client": "esbuild src/client/checkout.tsx --bundle --define:process.env.NODE_ENV='\"development\"' --outfile=public/checkout.js --watch",
    "start": "node dist/server/server.js",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
